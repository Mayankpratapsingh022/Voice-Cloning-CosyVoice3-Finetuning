# Copy to .env and fill in. Loaded by src/voiceclone/config.py via pydantic-settings.
# Modal auth itself is handled by `modal token set` / `modal setup`, not env vars here.

# Speaker identity, used as the utt/spk id prefix throughout the data pipeline.
VOICECLONE_SPEAKER_ID=mayank

# ModelScope/HuggingFace repo id for the base checkpoint to fine-tune from.
VOICECLONE_BASE_MODEL_ID=FunAudioLLM/Fun-CosyVoice3-0.5B-2512

# Modal Volume names. Change only if you want multiple independent datasets/experiments
# to coexist without overwriting each other.
VOICECLONE_DATASET_VOLUME=voiceclone-dataset
VOICECLONE_CHECKPOINT_VOLUME=voiceclone-checkpoints
VOICECLONE_PRETRAINED_VOLUME=voiceclone-pretrained
VOICECLONE_HF_CACHE_VOLUME=voiceclone-hf-cache

# Optional: HuggingFace token, only needed if the base model repo is gated.
HF_TOKEN=

# Optional: only needed for `voiceclone data prepare --transcribe-backend openai`.
# Read directly by the OpenAI SDK (not through our own Settings) — never commit a real
# key here; this file is the *.example*, your real .env is gitignored.
OPENAI_API_KEY=
