# Copy to .env and fill in. Loaded by src/voiceclone/config.py via pydantic-settings,
# and by python-dotenv (see cli.py's load_dotenv()) so third-party SDKs and the
# runpodctl CLI can also read keys straight from the environment.

# Speaker identity, used as the utt/spk id prefix throughout the data pipeline.
VOICECLONE_SPEAKER_ID=mayank

# ModelScope/HuggingFace repo id for the base checkpoint to fine-tune from.
VOICECLONE_BASE_MODEL_ID=FunAudioLLM/Fun-CosyVoice3-0.5B-2512

# A RunPod Network Volume, created once via the RunPod web console (Storage -> New
# Network Volume; runpodctl has no command for this). Required before any command
# that touches the pod (data extract, train, eval, serve).
VOICECLONE_RUNPOD_NETWORK_VOLUME_ID=

# Verify against `voiceclone pod gpus` for your account/region before a real run.
# 24GB is comfortably enough for CosyVoice3's 0.5B params, no need for anything bigger.
VOICECLONE_RUNPOD_GPU_TYPE=NVIDIA GeForce RTX 4090

# Optional: private HF dataset repo id used to transfer the prepared dataset to the
# pod. Defaults to "{your_hf_username}/voiceclone-{VOICECLONE_SPEAKER_ID}-dataset" if left blank.
VOICECLONE_HF_DATASET_REPO_ID=

# Required for renting and controlling GPU pods. Never paste this in chat or commit
# it; this file is the *.example*, your real .env is gitignored.
RUNPOD_API_KEY=

# Required: used both to push the prepared dataset to a private HF dataset repo, and
# by the pod to pull it back down. Needs write access to your account.
HF_TOKEN=

# Optional: only needed for `voiceclone data prepare --transcribe-backend openai`.
# Read directly by the OpenAI SDK, not through our own Settings.
OPENAI_API_KEY=
